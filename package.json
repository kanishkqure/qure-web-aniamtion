{
  "name": "qure-web-animation",
  "private": true,
  "type": "module",
  "scripts": {
    "extract:footer": "node tools/extract-footer-band.mjs",
    "build:footer": "esbuild footer/src/pill-band.ts --bundle --format=iife --global-name=QurePillBand --target=es2019 --outfile=footer/dist/pill-band.js && esbuild footer/src/pill-band.ts --bundle --format=esm --target=es2019 --outfile=footer/dist/pill-band.esm.js",
    "typecheck": "tsc --noEmit -p footer/tsconfig.json",
    "test:footer": "esbuild footer/test/band-model.test.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/band-model.test.cjs && node node_modules/.cache/band-model.test.cjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "fzstd": "0.1.1",
    "kiwi-schema": "0.5.0",
    "pako": "2.1.0",
    "typescript": "5.6.3"
  }
}
